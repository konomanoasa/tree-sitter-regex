CompileFlags:
  Add:
    - -std=c17
    - -xc
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header
    - -Wno-unused-function

---
If:
  PathMatch: test/[^/]*\.c
CompileFlags:
  Add:
    - -Wno-unused-function

---
If:
  PathMatch:
    - javascript/regex(_u|_v)?/src/.*
    - python/re(_verbose)?/src/.*
    - posix/(bre|ere)/src/.*
CompileFlags:
  Add:
    - -I.

---
If:
  PathMatch: javascript/common/scanner\.h
CompileFlags:
  Add:
    - -DJS_REGEX_MODE=0
    - -I../regex/src

---
If:
  PathMatch: python/common/scanner\.h
CompileFlags:
  Add:
    - -DPYTHON_RE_LANGUAGE=python_re
    - -I../re/src

---
If:
  PathMatch: posix/common/scanner\.h
CompileFlags:
  Add:
    - -DPOSIX_REGEX_MODE=0
    - -I../bre/src

---
If:
  PathMatch: test/scanner\.test\.c
CompileFlags:
  Add:
    - -DREGEX_SCANNER_SOURCE="../python/re/src/scanner.c"
    - -I../python/re/src
