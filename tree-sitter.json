{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ecmaregex",
      "title": "ECMAScript regex literal body",
      "scope": "source.ecmaregex",
      "path": "ecmascript/ecmaregex",
      "injection-regex": "^ecmaregex$",
      "highlights": "ecmascript/ecmaregex/queries/highlights.scm",
      "external-files": ["ecmascript/common/scanner.h"]
    },
    {
      "name": "ecmaregex_u",
      "title": "ECMAScript regex literal body (u)",
      "scope": "source.ecmaregex.u",
      "path": "ecmascript/ecmaregex_u",
      "injection-regex": "^ecmaregex_u$",
      "highlights": "ecmascript/ecmaregex_u/queries/highlights.scm",
      "external-files": ["ecmascript/common/scanner.h"]
    },
    {
      "name": "ecmaregex_v",
      "title": "ECMAScript regex literal body (v)",
      "scope": "source.ecmaregex.v",
      "path": "ecmascript/ecmaregex_v",
      "injection-regex": "^ecmaregex_v$",
      "highlights": "ecmascript/ecmaregex_v/queries/highlights.scm",
      "external-files": ["ecmascript/common/scanner.h"]
    },
    {
      "name": "pcre2",
      "title": "PCRE2",
      "scope": "source.pcre2",
      "path": "pcre2",
      "injection-regex": "^pcre2$",
      "highlights": "pcre2/queries/highlights.scm"
    },
    {
      "name": "posix_bre",
      "title": "POSIX BRE",
      "scope": "source.posix-bre",
      "path": "posix/bre",
      "injection-regex": "^posix_bre$",
      "highlights": "posix/bre/queries/highlights.scm",
      "external-files": ["posix/common/scanner.h"]
    },
    {
      "name": "posix_ere",
      "title": "POSIX ERE",
      "scope": "source.posix-ere",
      "path": "posix/ere",
      "injection-regex": "^posix_ere$",
      "highlights": "posix/ere/queries/highlights.scm",
      "external-files": ["posix/common/scanner.h"]
    },
    {
      "name": "pyregex",
      "title": "Python re",
      "scope": "source.pyregex",
      "path": "python/pyregex",
      "injection-regex": "^pyregex$",
      "highlights": "python/pyregex/queries/highlights.scm",
      "external-files": ["python/common/scanner.h"]
    },
    {
      "name": "pyregex_verbose",
      "title": "Python re (VERBOSE)",
      "scope": "source.pyregex.verbose",
      "path": "python/pyregex_verbose",
      "injection-regex": "^pyregex_verbose$",
      "highlights": "python/pyregex_verbose/queries/highlights.scm",
      "external-files": ["python/common/scanner.h"]
    }
  ],
  "metadata": {
    "version": "0.12.0",
    "license": "MIT",
    "description": "Tree-sitter grammars for ECMAScript regex, PCRE2, POSIX BRE/ERE, and Python re.",
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-regex"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": true,
    "rust": true,
    "swift": false
  }
}
