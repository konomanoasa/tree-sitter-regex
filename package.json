{
  "name": "@konomanoasa/tree-sitter-regex",
  "version": "0.4.0",
  "type": "module",
  "description": "Tree-sitter grammars for JavaScript regex and Python re.",
  "license": "MIT",
  "repository": "git+https://github.com/konomanoasa/tree-sitter-regex.git",
  "files": [
    "LICENSE-UNICODE",
    "common/**/*.h",
    "common/**/*.js",
    "javascript_regex*/grammar.js",
    "javascript_regex*/queries/*.scm",
    "javascript_regex*/src/*.c",
    "javascript_regex*/src/*.json",
    "javascript_regex*/src/tree_sitter/*.h",
    "python_re*/grammar.js",
    "python_re*/queries/*.scm",
    "python_re*/src/*.c",
    "python_re*/src/*.json",
    "python_re*/src/tree_sitter/*.h",
    "tree-sitter.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "biome check . && node scripts/check-c.js && node scripts/check-generated.js && npm test",
    "format": "biome check --write . && node scripts/check-c.js --write",
    "generate": "node scripts/generate-unicode.js && npm run tree-sitter -- generate-all",
    "parse:javascript": "npm run tree-sitter -- parse --scope source.javascript-regex",
    "parse:javascript:u": "npm run tree-sitter -- parse --scope source.javascript-regex.u",
    "parse:javascript:v": "npm run tree-sitter -- parse --scope source.javascript-regex.v",
    "parse:python": "npm run tree-sitter -- parse --scope source.python-re",
    "parse:python:verbose": "npm run tree-sitter -- parse --scope source.python-re.verbose",
    "test": "npm run tree-sitter -- test-corpus --rebuild && node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:fuzz": "node --test --test-name-pattern=\"fixed-seed generated histories\" test/incremental.test.js",
    "test:fuzz:corpus": "npm run tree-sitter -- fuzz-all --iterations 100 --edits 5",
    "test:highlights": "node --test test/highlight.test.js",
    "test:incremental": "node --test test/incremental.test.js",
    "test:sanitize": "node scripts/check-c.js --sanitize",
    "test:scanner": "node scripts/check-c.js",
    "tree-sitter": "node scripts/tree-sitter.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.5.1",
    "@unicode/unicode-17.0.0": "1.6.17",
    "tree-sitter-cli": "0.27.0"
  },
  "allowScripts": {
    "tree-sitter-cli": true
  }
}
