{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "js_regex",
      "title": "JavaScript regex literal body",
      "scope": "source.js-regex",
      "path": "javascript/regex",
      "injection-regex": "^js_regex$",
      "highlights": "javascript/regex/queries/highlights.scm",
      "external-files": ["javascript/common/scanner.h"]
    },
    {
      "name": "js_regex_u",
      "title": "JavaScript regex literal body (u)",
      "scope": "source.js-regex.u",
      "path": "javascript/regex_u",
      "injection-regex": "^js_regex_u$",
      "highlights": "javascript/regex_u/queries/highlights.scm",
      "external-files": ["javascript/common/scanner.h"]
    },
    {
      "name": "js_regex_v",
      "title": "JavaScript regex literal body (v)",
      "scope": "source.js-regex.v",
      "path": "javascript/regex_v",
      "injection-regex": "^js_regex_v$",
      "highlights": "javascript/regex_v/queries/highlights.scm",
      "external-files": ["javascript/common/scanner.h"]
    },
    {
      "name": "pcre2",
      "title": "PCRE2",
      "scope": "source.pcre2",
      "path": "pcre2",
      "injection-regex": "^pcre2$",
      "highlights": "pcre2/queries/highlights.scm"
    },
    {
      "name": "posix_bre",
      "title": "POSIX BRE",
      "scope": "source.posix-bre",
      "path": "posix/bre",
      "injection-regex": "^posix_bre$",
      "highlights": "posix/bre/queries/highlights.scm",
      "external-files": ["posix/common/scanner.h"]
    },
    {
      "name": "posix_ere",
      "title": "POSIX ERE",
      "scope": "source.posix-ere",
      "path": "posix/ere",
      "injection-regex": "^posix_ere$",
      "highlights": "posix/ere/queries/highlights.scm",
      "external-files": ["posix/common/scanner.h"]
    },
    {
      "name": "python_re",
      "title": "Python re",
      "scope": "source.python-re",
      "path": "python/re",
      "injection-regex": "^python_re$",
      "highlights": "python/re/queries/highlights.scm",
      "external-files": ["python/common/scanner.h"]
    },
    {
      "name": "python_re_verbose",
      "title": "Python re (VERBOSE)",
      "scope": "source.python-re.verbose",
      "path": "python/re_verbose",
      "injection-regex": "^python_re_verbose$",
      "highlights": "python/re_verbose/queries/highlights.scm",
      "external-files": ["python/common/scanner.h"]
    }
  ],
  "metadata": {
    "version": "0.10.0",
    "license": "MIT",
    "description": "Tree-sitter grammars for JavaScript regex, PCRE2, POSIX BRE/ERE, and Python re.",
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-regex"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}
