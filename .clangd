CompileFlags:
  Add:
    - -std=c17
    - -xc
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header
    - -Wno-unused-function

---
If:
  PathMatch: test/[^/]*\.c
CompileFlags:
  Add:
    - -Wno-unused-function

---
If:
  PathMatch:
    - ecmascript/ecmaregex(_u|_v)?/src/.*
    - python/pyregex(_verbose)?/src/.*
    - posix/(bre|ere)/src/.*
CompileFlags:
  Add:
    - -I.

---
If:
  PathMatch: ecmascript/common/scanner\.h
CompileFlags:
  Add:
    - -DECMAREGEX_MODE=0
    - -I../ecmaregex/src

---
If:
  PathMatch: python/common/scanner\.h
CompileFlags:
  Add:
    - -DPYREGEX_LANGUAGE=pyregex
    - -I../pyregex/src

---
If:
  PathMatch: posix/common/scanner\.h
CompileFlags:
  Add:
    - -DPOSIX_REGEX_MODE=0
    - -I../bre/src

---
If:
  PathMatch: test/scanner\.test\.c
CompileFlags:
  Add:
    - -DREGEX_SCANNER_SOURCE="../python/pyregex/src/scanner.c"
    - -I../python/pyregex/src

---
If:
  PathMatch: bindings/python/.*\.c
CompileFlags:
  CompilationDatabase: None
  Add:
    - -I../../ecmascript/ecmaregex/src
