{
  "name": "@konomanoasa/tree-sitter-regex",
  "version": "0.12.0",
  "description": "Tree-sitter grammars for ECMAScript regex, PCRE2, POSIX BRE/ERE, and Python re.",
  "license": "MIT",
  "repository": "git+https://github.com/konomanoasa/tree-sitter-regex.git",
  "type": "module",
  "files": [
    "**/grammar.js",
    "**/queries/*.scm",
    "**/src/*.c",
    "**/src/*.json",
    "**/src/tree_sitter/*.h",
    "*/common/*.h",
    "*/common/*.js",
    "Cargo.toml",
    "LICENSE-UNICODE",
    "bindings/python/*.c",
    "bindings/python/*.py",
    "bindings/python/*.pyi",
    "bindings/python/py.typed",
    "bindings/rust/*.rs",
    "pcre2/unicode.js",
    "pyproject.toml",
    "setup.py",
    "test/bindings.test.rs",
    "tree-sitter.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run tree-sitter -- build-all",
    "check": "biome check . && tsc",
    "check:queries": "npm run tree-sitter -- check-queries",
    "format": "biome format --write .",
    "generate": "node scripts/generate-unicode.js && npm run tree-sitter -- generate-all",
    "test": "npm run tree-sitter -- test-corpus --rebuild && node --test --test-concurrency=1 test/build.test.js test/cst.test.js test/highlight.test.js test/incremental.test.js test/parser.test.js && node scripts/check-c.js --test",
    "test:fuzz": "npm run tree-sitter -- fuzz-all --iterations 100 --edits 5",
    "test:sanitize": "node scripts/check-c.js --sanitize",
    "tree-sitter": "node scripts/tree-sitter.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "@unicode/unicode-17.0.0": "2.0.8",
    "tree-sitter-cli": "0.27.1",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "tree-sitter-cli": true
  }
}
